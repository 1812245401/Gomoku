<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/canvas">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="图片识谱" android:textSize="28sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:layout_marginTop="8dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="选择照片 · 框选棋盘 · 校正后导入" android:textSize="13sp" android:textColor="@color/muted" android:layout_marginTop="6dp" android:layout_marginBottom="20dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_board_card">
<TextView android:id="@+id/tv_recog_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="正在加载半步识别模块…" android:textColor="@color/ink" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
<TextView android:id="@+id/tv_recog_conf" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="置信度 —" android:textColor="@color/accent" android:textSize="12sp"/>
</LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp"><Button android:id="@+id/btn_recog_pick" style="@style/Control" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="3dp" android:text="选择照片" android:background="@drawable/bg_button_secondary" android:textColor="@color/control_text" /><Button android:id="@+id/btn_recog_roi" style="@style/Control" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="3dp" android:text="重新框选" android:background="@drawable/bg_button_secondary" android:textColor="@color/control_text" android:enabled="false"/><Button android:id="@+id/btn_recog_run" style="@style/Control" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="3dp" android:text="开始识别" android:background="@drawable/bg_button_primary" android:textColor="@color/primary_text" /></LinearLayout><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="局面预览" android:textSize="16sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:layout_marginTop="24dp" android:layout_marginBottom="6dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="可补子、删子；识别的是局面，不还原手序。" android:textSize="12sp" android:textColor="@color/muted" android:layout_marginBottom="12dp"/><FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:background="@drawable/bg_board_card"><com.gomoku.BoardView android:id="@+id/board_preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"/></FrameLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp"><Button android:id="@+id/btn_preview_place" style="@style/Control" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="3dp" android:text="补子" android:background="@drawable/bg_segment_left" android:textColor="@color/control_text" /><Button android:id="@+id/btn_preview_delete" style="@style/Control" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="3dp" android:text="删子" android:background="@drawable/bg_segment_right" android:textColor="@color/control_text" /><Button android:id="@+id/btn_preview_color" style="@style/Control" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="3dp" android:text="落子色:黑" android:background="@drawable/bg_button_secondary" android:textColor="@color/control_text" /></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp"><Button android:id="@+id/btn_recog_cancel" style="@style/Control" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="3dp" android:text="取消" android:background="@drawable/bg_button_secondary" android:textColor="@color/control_text" /><Button android:id="@+id/btn_recog_import" style="@style/Control" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="3dp" android:text="导入到棋盘" android:background="@drawable/bg_button_primary" android:textColor="@color/primary_text" /></LinearLayout><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="本地识别模块" android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="20dp" android:layout_marginBottom="6dp"/><WebView android:id="@+id/web_recognize" android:layout_width="match_parent" android:layout_height="64dp"/>
</LinearLayout></ScrollView>
<LinearLayout android:id="@+id/roi_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F2182D29" android:orientation="vertical" android:padding="16dp" android:visibility="gone" android:clickable="true" android:focusable="true">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="框选棋盘" android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:layout_marginBottom="8dp"/>
<TextView android:id="@+id/tv_roi_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="拖动框住完整棋盘与棋子，可拖动四角微调。未框选时将自动定位。" android:textColor="#D5E4DD" android:textSize="13sp" android:lineSpacingExtra="3dp"/>
<com.gomoku.RoiCropView android:id="@+id/view_roi_crop" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" ><Button android:id="@+id/btn_roi_reset" style="@style/Control" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="3dp" android:text="清除框选" android:background="@drawable/bg_button_secondary" android:textColor="@color/control_text" /><Button android:id="@+id/btn_roi_confirm" style="@style/Control" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="3dp" android:text="确定区域" android:background="@drawable/bg_button_primary" android:textColor="@color/primary_text" /></LinearLayout></LinearLayout></FrameLayout>
